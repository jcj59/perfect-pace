{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perfect-pace",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Per-PR previews are Worker versions with a `pr-<number>` preview alias.
  "preview_urls": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Per-IP limit on upstream routing requests (see src/route.ts). `limit` and `period` must match
  // ROUTE_RATE_LIMIT and ROUTE_RATE_PERIOD_S there. The namespace id is any integer unique to this
  // account.
  "ratelimits": [{ "name": "ROUTE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // ORS_API_KEY is a secret: `wrangler secret put ORS_API_KEY`, or the ORS_API_KEY GitHub secret
  // (the Deploy workflow uploads it). Locally, put it in apps/worker/.dev.vars.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
}
