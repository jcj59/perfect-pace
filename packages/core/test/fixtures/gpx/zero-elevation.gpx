<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-made: every elevation is exactly 0, a placeholder some exporters write when they have
     none, so the parser treats the course as having no elevation. -->
<gpx version="1.1" creator="hand-made" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <trkseg>
      <trkpt lat="42.43800" lon="-76.49900"><ele>0</ele></trkpt>
      <trkpt lat="42.43900" lon="-76.49900"><ele>0.0</ele></trkpt>
      <trkpt lat="42.44000" lon="-76.49900"/>
      <trkpt lat="42.44100" lon="-76.49900"><ele>0.000000</ele></trkpt>
    </trkseg>
  </trk>
</gpx>
